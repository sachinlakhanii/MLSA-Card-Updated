# Copy these into Vercel: Project Settings > Environment Variables. Never commit real values.

# Secret you type into the studio to publish. Use a long random string.
ADMIN_KEY=

# Fine-grained GitHub token limited to the PUBLIC WEBSITE repo only, permission "Contents: Read and write".
GITHUB_TOKEN=

# Public website repository, as owner/name
GITHUB_REPO=your-username/msa-szabist-website
GITHUB_BRANCH=main

# Public website address, no trailing slash
SITE_URL=https://your-website.vercel.app
